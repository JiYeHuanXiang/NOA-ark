{
  "name": "noa-ark",
  "version": "0.1.0",
  "private": true,
  "description": "NOA Ark — QQ official bot platform to OneBot v11 / Milky adapter",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "noa-ark": "./bin/noa.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node bin/noa.mjs start",
    "doctor": "node bin/noa.mjs doctor"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
