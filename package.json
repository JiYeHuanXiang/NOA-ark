{
  "name": "noa-ark",
  "version": "0.1.9",
  "private": true,
  "description": "NOA Ark — QQ official bot platform to OneBot v11 adapter",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/cli.js",
  "exports": {
    ".": "./dist/dsh/plugin.js",
    "./cli": "./dist/cli.js",
    "./dsh": "./dist/dsh/plugin.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./dsh/locale/*.json": "./locale/*.json",
    "./dsh/icon": "./icon.svg"
  },
  "bin": {
    "noa-ark": "./bin/noa.mjs"
  },
  "files": [
    "dist",
    "bin",
    "client.js",
    "cordis.patch.yml",
    "docs/PLUGIN.md",
    "docs/PLUGIN.zh.md",
    "locale",
    "icon.svg"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node bin/noa.mjs start",
    "doctor": "node bin/noa.mjs doctor"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "icon": "./icon.svg",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
